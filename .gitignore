# Atrium — what git must never track.
#
# Build output. Nothing here is source, and nothing here is needed to build the
# project: `cargo build` regenerates target/ from the source and Cargo.lock.
target/

# Flutter/Dart build output (spikes/0a-bridge/bridge-flutter).
.dart_tool/
build/

# JetBrains/IntelliJ editor state. Per-machine, not per-project.
.idea/

# Hermes agent-instruction folders. These are local tool configuration, not
# project source, and each one is regenerated per machine.
.hermes/

# Logs. Written by whatever ran last, useful for minutes and never for history.
*.log

# Flutter's prebuilt engine binaries inside a spike. The Flutter scaffold's own
# linux/.gitignore already ignores this path; the line is repeated here so the
# exclusion survives even if that scaffold file is ever regenerated.
spikes/**/linux/flutter/ephemeral/

# Python bytecode. The CI reporting scripts are run directly and get imported
# or compiled on the way, which leaves a __pycache__ next to them; committing
# that is noise in every future diff that touches those scripts.
__pycache__/
*.pyc

# cargo-mutants working directories. A `cargo mutants` run writes its verdicts
# and the mutated source snapshots here, and renames the previous run to
# `mutants.out.old` rather than deleting it -- so both appear as untracked after
# every run. They are tool output, reproducible by re-running the tool, and must
# never be committed; the mutants topic's own rule is `rm -rf mutants.out*`
# before staging, which is easy to forget and leaves the tree dirty.
mutants.out/
mutants.out.old/
